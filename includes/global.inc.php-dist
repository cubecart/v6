// Database
// Name e.g. cubecart
$glob['dbdatabase'] 	= '';
// Server hostname e.g. localhost (can be domain or ip address)
$glob['dbhost'] 		= '';
// Table prefix e.g. store_1_ (handy for multiple stores in one database)
$glob['dbprefix'] 		= '';
// Server port e.g. 3306 (can be left empty)
$glob['dbport'] 		= '';
// Server socket e.g. /var/mysql/mysql.sock (can be left empty)
$glob['dbsocket'] 		= '';
// Username that has access to the database
$glob['dbusername'] 	= '';
// Password for username above
$glob['dbpassword'] 	= '';

// Installation
// Set to 1 if store is installed. Prevents setup redirect.
$glob['installed'] 		= '0';

// Admin
// Change these if you have renamed the admin folder or file
$glob['adminFolder'] 	= 'admin';
$glob['adminFile'] 		= 'admin.php';

// Cache (file, memcached, redis)
$glob['cache'] 			= 'file';

// Memcached server host and port
$glob['memcached_servers'] = array('127.0.0.1', 11211);

// Redis server settings
$glob['redis_host'] 	= '127.0.0.1';
$glob['redis_port'] 	= 6379;
// Leave empty if no password
$glob['redis_password'] = '';
// Database number
$glob['redis_db'] 		= 0;

// Sessions
// Set your own session save path e.g. 127.0.0.1:11211
$glob['session_save_path'] = '';
// Set your own session save handler e.g. memcached
$glob['session_save_handler'] = '';

// Safety and maintenance
// Set to true to disable hooks and code snippets, 'hooks' to disable code hooks, 'snippets' to disable code snippets
$glob['safe_mode'] = false;
// Set to an email address to disable auto upgrade with a message about who to contact, or false
$glob['auto_upgrade_disabled'] = false;

// Newsletter
// Set to 1 to enable lax subscribe mode (allows double opt-in to be disabled)
$glob['subscribe_mode_lax'] = '0';

// Search
// Columns used for LIKE search
$glob['search_columns'] = array('name', 'description', 'product_code');

// Elasticsearch
// Host e.g. https://localhost:9200
$glob['es_h'] 		= '';
// Username
$glob['es_u'] 		= '';
// Password
$glob['es_p'] 		= '';
// Index name
$glob['es_i'] 		= '';
// Certificate validation (1 or 0)
$glob['es_v'] 		= '';
// Certificate path
$glob['es_c'] 		= '';

// Bot detection
// UA signatures for session blocking (layer 2 - catches bots that spoof browser UAs)
// Simple bots (curl, python etc.) are already blocked by the mozilla/ whitelist check
$glob['bot_sigs']	= array('bot', 'crawl', 'spider', 'slurp', 'headless', 'phantom', 'puppeteer', 'lighthouse', 'pagespeed', 'gtmetrix', 'pingdom', 'uptimerobot', 'statuscake', 'semrush', 'ahrefs', 'majestic', 'dotbot', 'facebookexternal');
