<?xml version="1.0"?>
<skin version="1.0">
  <info>
	<uid>atrium-1.0@cubecart.com</uid>
	<type>skin</type>
	<category>skin</category>
	<!-- MUST be byte-identical to the directory name: this string is the key in
	     GUI::listSkins() (gui.class.php:640), the value stored in config.skin_folder,
	     and the path segment used for Smarty's template_dir (gui.class.php:137). -->
	<name><![CDATA[atrium]]></name>
	<!-- Leave as atrium if your custom skin derives from this one. -->
	<original_name><![CDATA[atrium]]></original_name>
	<display><![CDATA[Atrium]]></display>
	<description><![CDATA[CubeCart's default skin. Tailwind CSS and Alpine.js, built as a clean canvas for your own design.]]></description>
	<version>1.0.0</version>
	<!-- 6.7.6 is a real floor, not politeness: content.withdraw.php and the
	     single-gateway hidden-input behaviour arrive in 6.7.4, and element.meta.php
	     changes in 6.7.6. Core reads this for display only (plugins.index.inc.php:418)
	     and does NOT enforce it, so main.php also shows an admin-only banner. -->
	<minVersion>6.7.6</minVersion>
	<maxVersion>6.*.*</maxVersion>
	<creator>CubeCart</creator>
	<homepage>https://www.cubecart.com</homepage>
	<layout_type>responsive</layout_type>
	<framework>tailwind</framework>
	<!-- Truthy force-writes config.csrf='1' store-wide (gui.class.php:130-134).
	     GUI::display() then injects the token before every </form> (gui.class.php:340). -->
	<csrf>true</csrf>
	<!-- Enforces captcha for anonymous newsletter signup (newsletter.class.php:425). -->
	<newsletter_recaptcha>true</newsletter_recaptcha>
	<!-- TRUE skips a blocking per-review cURL HEAD to gravatar.com (catalogue.class.php:442). -->
	<gravatar_ajax>true</gravatar_ajax>
	<!-- Admin force-enables disable_mobile_skin on save (gui.class.php:651). -->
	<responsive>true</responsive>
  </info>
  <layout>
	<products>
		<perpage amount="12" />
		<perpage default="true" amount="24" />
		<perpage amount="48" />
		<perpage amount="96" />
	</products>
  </layout>
  <styles>
	<!-- images="false" means image paths resolve at the images/ ROOT, so
	     images/noimage.png must exist there (not images/default/). -->
	<style images="false" default="true">
	  <directory>default</directory>
	  <name><![CDATA[Default]]></name>
	  <description><![CDATA[Default Subtheme]]></description>
	  <default />
	</style>
  </styles>
  <!-- Each reference here literally creates $PRODUCT.<reference> and
       $product['image_tags'][<reference>] (gui.class.php:685-694,
       catalogue.class.php:1906-1922). Removing one removes that Smarty variable. -->
  <images>
	<image reference="thumbnail" maximum="400" quality="82" default="noimage.png" />
	<image reference="category" maximum="1200" quality="82" default="noimage.png" />
	<image reference="subcategory" maximum="300" quality="82" default="noimage.png" />
	<image reference="gallery" maximum="120" quality="82" default="noimage.png" />
	<image reference="checkout" maximum="120" quality="82" default="noimage.png" />
	<image reference="normal" maximum="600" quality="82" default="noimage.png" />
	<image reference="enlarge" maximum="1600" quality="82" default="noimage.png" />
	<image reference="tiny" maximum="64" quality="82" default="noimage.png" />
	<image reference="small" maximum="300" quality="82" default="noimage.png" />
	<image reference="medium" maximum="800" quality="82" default="noimage.png" />
	<image reference="large" maximum="1200" quality="82" default="noimage.png" />
  </images>
  <!-- MERCHANT-EDITABLE settings. Declaring any <setting> here puts a config cog
       on this skin's card in Manage Extensions; the values are stored in the
       config table under "skin_atrium" and reach templates as
       $SKIN_SETTINGS[<name>], cached under skin.atrium.settings.

       Contrast with <custom> below, which is developer-only: it has no admin UI
       and lives solely in this file.

         name      [a-z0-9_], becomes the config_key and the Smarty key
         type      bool | select | text   (anything else is treated as text)
         default   used until the merchant saves; for bool: 1/true/yes/on
         label     shown in admin; falls back to the name, title-cased
         options   select only, and a select with none of them is skipped

       bool reaches templates as a real boolean, so {if $SKIN_SETTINGS.x} is
       safe — a stored "0" would otherwise be a truthy non-empty string. -->
  <settings>
	<setting name="show_company_name" type="bool" default="true">
	  <label><![CDATA[Show Company Name]]></label>
	  <description><![CDATA[Show the company name field on address and checkout forms.]]></description>
	</setting>
	<setting name="show_order_comments" type="bool" default="true">
	  <label><![CDATA[Show Delivery Notes or Additional Comments]]></label>
	  <description><![CDATA[Show the free-text comments box at the end of checkout. Existing comments still appear on orders and receipts when this is off.]]></description>
	</setting>
	<setting name="show_mailing_list" type="bool" default="true">
	  <label><![CDATA[Show Subscribe to Mailing List]]></label>
	  <description><![CDATA[Show the newsletter opt-in on checkout. Has no effect when the store's newsletter is switched off in Store Settings.]]></description>
	</setting>
	<setting name="show_coupon_code" type="bool" default="true">
	  <label><![CDATA[Show Promo Code Field]]></label>
	  <description><![CDATA[Show the promo/discount code box on checkout. Codes already applied to the basket still show, so a customer can always see and remove one.]]></description>
	</setting>
	<setting name="show_featured" type="bool" default="true">
	  <label><![CDATA[Show Featured Products]]></label>
	  <description><![CDATA[Show the Featured Products box in the storefront sidebar.]]></description>
	</setting>
	<setting name="show_best_sellers" type="bool" default="true">
	  <label><![CDATA[Show Best Sellers]]></label>
	  <description><![CDATA[Show the Best Sellers box in the storefront sidebar.]]></description>
	</setting>
	<setting name="show_sale_items" type="bool" default="true">
	  <label><![CDATA[Show Sale Items]]></label>
	  <description><![CDATA[Show the Sale Items box in the storefront sidebar. With all three sidebar boxes off the page content takes the full width.]]></description>
	</setting>
	<setting name="registration_mode" type="select" default="choice">
	  <label><![CDATA[Checkout Registration]]></label>
	  <description><![CDATA[Whether a customer may create an account while checking out. Existing customers can always log in, whichever is chosen.]]></description>
	  <options>
		<option value="choice"><![CDATA[Customer chooses]]></option>
		<option value="guest"><![CDATA[Guest checkout only]]></option>
		<option value="required"><![CDATA[Registration required]]></option>
	  </options>
	</setting>
  </settings>
  <!-- Flattened into $SKIN_CUSTOM[<name>], one level only (gui.class.php:1946-1957).
       Cached under skin.atrium.custom — clear the cache after editing. -->
  <custom>
	<recaptcha_badge_position>bottomright</recaptcha_badge_position><!-- bottomright | bottomleft | inline -->
	<colour_scheme>light</colour_scheme><!-- light | auto -->
	<container_width>screen-2xl</container_width>
  </custom>
</skin>
